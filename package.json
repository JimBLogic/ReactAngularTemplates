{
  "name": "frontend-ui-components",
  "version": "2.0.0",
  "description": "React and Angular UI components for business apps, styled with Tailwind CSS.",
  "private": true,
  "type": "module",
  "scripts": {
  "dev": "echo 'UI components ready - check README for setup'",
    "build": "tsc --noEmit && echo 'Type check passed'",
    "type-check": "tsc --noEmit",
  "validate": "npm run type-check && echo 'Components validated'",
  "test": "echo 'Run tests in your project after copying components'",
    
  "preview": "echo 'Open template-viewer.html to preview components'"
  },
  "dependencies": {
    "i18next": "^25.5.2",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
